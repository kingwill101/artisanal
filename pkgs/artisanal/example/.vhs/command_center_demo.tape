Output pkgs/artisanal/assets/command_center_demo.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/artisanal/command_center_demo.dill"
Enter
Wait+Screen /COMMAND CENTER/
Sleep 2s
Type "2"
Sleep 700ms
Type "3"
Sleep 700ms
Type "s"
Sleep 700ms
Type "s"
Sleep 700ms
Type "c"
Sleep 700ms
Type "c"
Sleep 700ms
Type "/"
Sleep 400ms
Type "error"
Sleep 500ms
Enter
Sleep 1.5s
Type "q"
Sleep 1s
