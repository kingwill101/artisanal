Output pkgs/artisanal/assets/data_table_demo.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/artisanal/data_table_demo.dill"
Enter
Wait+Screen /Active Processes/
Sleep 2s
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "f"
Sleep 600ms
Type "j"
Sleep 400ms
Enter
Sleep 2s
