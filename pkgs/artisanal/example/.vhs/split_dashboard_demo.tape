Output pkgs/artisanal/assets/split_dashboard_demo.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/artisanal/split_dashboard_demo.dill"
Enter
Wait+Screen /SPLIT MODE DEMO/
Sleep 2s
Type "+"
Sleep 500ms
Type "+"
Sleep 500ms
Type "+"
Sleep 500ms
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "u"
Sleep 800ms
Type "u"
Sleep 800ms
Type "G"
Sleep 700ms
Type "q"
Sleep 1s
