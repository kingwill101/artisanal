Output pkgs/artisanal/assets/log_viewer_demo.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/artisanal/log_viewer_demo.dill"
Enter
Wait+Screen /LOG VIEWER/
Sleep 2s
Type "u"
Sleep 800ms
Type "u"
Sleep 800ms
Tab
Sleep 700ms
Tab
Sleep 700ms
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "G"
Sleep 700ms
Type "q"
Sleep 1s
