Output pkgs/artisanal_widgets/assets/debug_console.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 720
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/widgets/debug_console.dill"
Enter
Wait+Screen /Debug Console/
Sleep 2s
Type " "
Sleep 500ms
Type " "
Sleep 500ms
Type "w"
Sleep 500ms
Type "e"
Sleep 800ms
Type " "
Sleep 500ms
Type "c"
Sleep 600ms
Type "q"
Sleep 1s
