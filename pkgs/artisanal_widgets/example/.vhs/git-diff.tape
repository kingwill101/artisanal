Output pkgs/artisanal_widgets/assets/git-diff.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 720
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/widgets/git-diff.dill"
Enter
Wait+Screen /Git Diff Viewer/
Sleep 2s
Type "v"
Sleep 900ms
Type "v"
Sleep 900ms
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "j"
Sleep 400ms
Type "G"
Sleep 700ms
Type "q"
Sleep 1s
