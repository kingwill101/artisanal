Output pkgs/artisanal_widgets/assets/modal_drawer.gif

Require dart

Set Shell "bash"
Set FontFamily "DejaVu Sans Mono"
Set FontSize 16
Set LetterSpacing 0
Set Width 1200
Set Height 720
Set Theme "Catppuccin Mocha"
Set TypingSpeed 35ms
Set PlaybackSpeed 1.25
Set CursorBlink false

Type "dart run build/vhs/widgets/modal_drawer.dill"
Enter
Wait+Screen /Modal & Drawer Showcase/
Sleep 2s
Type "m"
Sleep 1s
Type "m"
Sleep 1s
Type "d"
Sleep 1s
Type "d"
Sleep 1s
Type "q"
Sleep 1s
